node_modules/
out/
dist/
.vscode-test/
*.vsix
*.zip
*.map
__pycache__/
test/fixtures/pyproject/.vscode/
# KeepSafe's local checkpoint store; it belongs to the machine, not the repository.
.keepsafe/
# DeepTest's working files are regenerated on every check; the decisions travel with the code.
.deeptest/*
!.deeptest/decisions.json

# Fixture copies of the HelloWorlds ports (scripts/sync-fixtures.mjs) install their own dependencies when a test needs them.
test/fixtures/helloworld-*/node_modules/
# The behaviour gate's working folders, and Playwright's own output, under any
# fixture. The rules below carry a slash, so git anchors them to this file's
# folder and they never reached test/fixtures/helloworld-*/.
**/.untangleit/*
**/test-results/
# UntangleIt's working files, when UntangleIt measures this project; the run record travels with the code.
.untangleit/*
!.untangleit/runs.json
# The tool was renamed to UntangleIt on 2026-09-11. Its records must not come back.
.refactorit/**
